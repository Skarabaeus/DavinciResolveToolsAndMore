{
	Tools = ordered() {
		PhotoFrame = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "PhotoIn", Source = "Input", },
				Input1 = InstanceInput { SourceOp = "Frame", Source = "PhotoSize", Name = "Photo Size", Default = 0.9, },
				Input2 = InstanceInput { SourceOp = "Frame", Source = "BorderWidth", Name = "Border Width", Default = 0.013, },
				Input3 = InstanceInput { SourceOp = "Frame", Source = "BorderRed", Name = "Border Color", ControlGroup = 10, Default = 1, },
				Input4 = InstanceInput { SourceOp = "Frame", Source = "BorderGreen", ControlGroup = 10, Default = 1, },
				Input5 = InstanceInput { SourceOp = "Frame", Source = "BorderBlue", ControlGroup = 10, Default = 1, },
				Input6 = InstanceInput { SourceOp = "Frame", Source = "TopLeftRed", Name = "Gradient Top Left", ControlGroup = 11, Default = 0.369, },
				Input7 = InstanceInput { SourceOp = "Frame", Source = "TopLeftGreen", ControlGroup = 11, Default = 0.369, },
				Input8 = InstanceInput { SourceOp = "Frame", Source = "TopLeftBlue", ControlGroup = 11, Default = 0.369, },
				Input9 = InstanceInput { SourceOp = "Frame", Source = "TopRightRed", Name = "Gradient Top Right", ControlGroup = 12, Default = 0.569, },
				Input10 = InstanceInput { SourceOp = "Frame", Source = "TopRightGreen", ControlGroup = 12, Default = 0.569, },
				Input11 = InstanceInput { SourceOp = "Frame", Source = "TopRightBlue", ControlGroup = 12, Default = 0.569, },
				Input12 = InstanceInput { SourceOp = "Frame", Source = "BottomLeftRed", Name = "Gradient Bottom Left", ControlGroup = 13, Default = 0.259, },
				Input13 = InstanceInput { SourceOp = "Frame", Source = "BottomLeftGreen", ControlGroup = 13, Default = 0.259, },
				Input14 = InstanceInput { SourceOp = "Frame", Source = "BottomLeftBlue", ControlGroup = 13, Default = 0.259, },
				Input15 = InstanceInput { SourceOp = "Frame", Source = "BottomRightRed", Name = "Gradient Bottom Right", ControlGroup = 14, Default = 0.129, },
				Input16 = InstanceInput { SourceOp = "Frame", Source = "BottomRightGreen", ControlGroup = 14, Default = 0.129, },
				Input17 = InstanceInput { SourceOp = "Frame", Source = "BottomRightBlue", ControlGroup = 14, Default = 0.129, },
				Input18 = InstanceInput { SourceOp = "Frame", Source = "ShadowStrength", Name = "Shadow Strength", Default = 0.85, },
				Input19 = InstanceInput { SourceOp = "Frame", Source = "ShadowSoftness", Name = "Shadow Softness", Default = 30, },
				Input20 = InstanceInput { SourceOp = "Frame", Source = "ShadowDistance", Name = "Shadow Distance", Default = 0.005, },
				Input21 = InstanceInput { SourceOp = "Frame", Source = "Width", Name = "Canvas Width", Default = 3840, },
				Input22 = InstanceInput { SourceOp = "Frame", Source = "Height", Name = "Canvas Height", Default = 2160, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "MergePhoto", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 }, },
			Tools = ordered() {
				Frame = Background {
					CtrlWZoom = false,
					Inputs = {
						GlobalOut = Input { Value = 119, },
						UseFrameFormatSettings = Input { Value = 0, },
						Width = Input { Value = 3840, },
						Height = Input { Value = 2160, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						Type = Input { Value = FuID { "Corner" }, },
						TopLeftRed = Input { Value = 0.369, },
						TopLeftGreen = Input { Value = 0.369, },
						TopLeftBlue = Input { Value = 0.369, },
						TopRightRed = Input { Value = 0.569, },
						TopRightGreen = Input { Value = 0.569, },
						TopRightBlue = Input { Value = 0.569, },
						BottomLeftRed = Input { Value = 0.259, },
						BottomLeftGreen = Input { Value = 0.259, },
						BottomLeftBlue = Input { Value = 0.259, },
						BottomRightRed = Input { Value = 0.129, },
						BottomRightGreen = Input { Value = 0.129, },
						BottomRightBlue = Input { Value = 0.129, },
						TopLeftAlpha = Input { Value = 1, },
						TopRightAlpha = Input { Value = 1, },
						BottomLeftAlpha = Input { Value = 1, },
						BottomRightAlpha = Input { Value = 1, },
						PhotoSize = Input { Value = 0.9, },
						BorderWidth = Input { Value = 0.013, },
						BorderRed = Input { Value = 1, },
						BorderGreen = Input { Value = 1, },
						BorderBlue = Input { Value = 1, },
						ShadowStrength = Input { Value = 0.85, },
						ShadowSoftness = Input { Value = 30, },
						ShadowDistance = Input { Value = 0.005, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
					UserControls = ordered() {
						PhotoSize = { LINKS_Name = "Photo Size", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 0.9, INP_MinScale = 0.1, INP_MaxScale = 1, INP_MinAllowed = 0, ICS_ControlPage = "Controls", },
						BorderWidth = { LINKS_Name = "Border Width", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 0.013, INP_MinScale = 0, INP_MaxScale = 0.05, INP_MinAllowed = 0, ICS_ControlPage = "Controls", },
						BorderRed = { LINKS_Name = "Border Color", LINKID_DataType = "Number", INPID_InputControl = "ColorControl", INP_Default = 1, INP_MinScale = 0, INP_MaxScale = 1, IC_ControlGroup = 1, IC_ControlID = 0, ICS_ControlPage = "Controls", },
						BorderGreen = { LINKID_DataType = "Number", INPID_InputControl = "ColorControl", INP_Default = 1, INP_MinScale = 0, INP_MaxScale = 1, IC_ControlGroup = 1, IC_ControlID = 1, ICS_ControlPage = "Controls", },
						BorderBlue = { LINKID_DataType = "Number", INPID_InputControl = "ColorControl", INP_Default = 1, INP_MinScale = 0, INP_MaxScale = 1, IC_ControlGroup = 1, IC_ControlID = 2, ICS_ControlPage = "Controls", },
						ShadowStrength = { LINKS_Name = "Shadow Strength", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 0.85, INP_MinScale = 0, INP_MaxScale = 1, INP_MinAllowed = 0, ICS_ControlPage = "Controls", },
						ShadowSoftness = { LINKS_Name = "Shadow Softness", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 30, INP_MinScale = 0, INP_MaxScale = 100, INP_MinAllowed = 0, ICS_ControlPage = "Controls", },
						ShadowDistance = { LINKS_Name = "Shadow Distance", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 0.005, INP_MinScale = 0, INP_MaxScale = 0.05, INP_MinAllowed = 0, ICS_ControlPage = "Controls", },
					},
				},
				PhotoIn = Transform {
					ViewInfo = OperatorInfo { Pos = { 0, -66 } },
				},
				Card = Background {
					Inputs = {
						GlobalOut = Input { Value = 119, },
						UseFrameFormatSettings = Input { Value = 0, },
						Width = Input { Value = 1920, Expression = ":return PhotoIn.Output.Width*Frame.PhotoSize*math.min(Frame.Width/PhotoIn.Output.Width, Frame.Height/PhotoIn.Output.Height)+2*Frame.BorderWidth*Frame.Height", },
						Height = Input { Value = 1080, Expression = ":return PhotoIn.Output.Height*Frame.PhotoSize*math.min(Frame.Width/PhotoIn.Output.Width, Frame.Height/PhotoIn.Output.Height)+2*Frame.BorderWidth*Frame.Height", },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftRed = Input { Value = 1, Expression = "Frame.BorderRed", },
						TopLeftGreen = Input { Value = 1, Expression = "Frame.BorderGreen", },
						TopLeftBlue = Input { Value = 1, Expression = "Frame.BorderBlue", },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, -99 } },
				},
				Clear = Background {
					Inputs = {
						GlobalOut = Input { Value = 119, },
						UseFrameFormatSettings = Input { Value = 0, },
						Width = Input { Value = 1920, Expression = "Frame.Width", },
						Height = Input { Value = 1080, Expression = "Frame.Height", },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 99 } },
				},
				CardLayer = Merge {
					Inputs = {
						Background = Input { SourceOp = "Clear", Source = "Output", },
						Foreground = Input { SourceOp = "Card", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 99 } },
				},
				FrameShadowBlur = Blur {
					Inputs = {
						XBlurSize = Input { Value = 30, Expression = "Frame.ShadowSoftness*Frame.Height/1080", },
						Input = Input { SourceOp = "CardLayer", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { 330, 99 } },
				},
				FrameShadowTint = ColorGain {
					Inputs = {
						GainRed = Input { Value = 0, },
						GainGreen = Input { Value = 0, },
						GainBlue = Input { Value = 0, },
						GainAlpha = Input { Value = 0.85, Expression = "Frame.ShadowStrength", },
						Input = Input { SourceOp = "FrameShadowBlur", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 99 } },
				},
				MergeShadow = Merge {
					Inputs = {
						Background = Input { SourceOp = "Frame", Source = "Output", },
						Foreground = Input { SourceOp = "FrameShadowTint", Source = "Output", },
						Center = Input { Value = { 0.5, 0.495 }, Expression = "Point(0.5, 0.5-Frame.ShadowDistance)", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 } },
				},
				MergeCard = Merge {
					Inputs = {
						Background = Input { SourceOp = "MergeShadow", Source = "Output", },
						Foreground = Input { SourceOp = "Card", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 550, 0 } },
				},
				MergePhoto = Merge {
					Inputs = {
						Background = Input { SourceOp = "MergeCard", Source = "Output", },
						Foreground = Input { SourceOp = "PhotoIn", Source = "Output", },
						Size = Input { Value = 1, Expression = ":return Frame.PhotoSize*math.min(Frame.Width/PhotoIn.Output.Width, Frame.Height/PhotoIn.Output.Height)", },
						FilterMethod = Input { Value = 8, },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 660, 0 } },
				},
			},
		},
	},
	ActiveTool = "PhotoFrame"
}
